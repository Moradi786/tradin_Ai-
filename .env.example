# ==== Telegram (الزامی) ====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== AI providers (حداقل یکی) ====
# Gemini - https://aistudio.google.com (رایگان)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq - https://console.groq.com (رایگان)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OpenRouter - مدل‌های :free دارد
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# اجبار provider خاص: gemini / groq / openrouter / openai
AI_PROVIDER=

# ==== منابع داده ====
LIVECOINWATCH_API_KEY=
CRYPTOMETER_API_KEY=
COINMARKETCAP_API_KEY=

# ==== ردیابی عملکرد (Turso - اختیاری) ====
# https://turso.tech → ساخت دیتابیس رایگان
# مثال: libsql://yourdb-user.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# حداقل حرکت (٪) برای موفق دانستن LONG/SHORT در ۴ ساعت
TRACKER_WIN_MOVE=1.5
# برای EARLY: حداقل حرکت بزرگ در هر جهت
TRACKER_EARLY_WIN_MOVE=2.0

# ==== تنظیمات اسکنر ====
# برای جلوگیری از بن بایننس روی آی‌پی اشتراکی Render:
SCAN_INTERVAL=300
MAX_SYMBOLS=50
SCAN_CONCURRENCY=8
VOLUME_MULTIPLIER=2.0
MAX_PRICE_MOVE=1.5
VOLUME_LOOKBACK=20
SIGNAL_COOLDOWN=1800
DOMINANCE_INTERVAL=60
LWC_INTERVAL=120
LWC_LIMIT=100

# ==== Rate limit ====
# کش لیست tickers بایننس (ثانیه)
TICKERS_INTERVAL=60
# وقتی بایننس 418/429 بدهد، اسکن‌ها این مدت متوقف می‌شوند
BINANCE_BLOCK_PAUSE=300
# منبع dominance خطادار این مدت کنار گذاشته می‌شود
SOURCE_FAIL_COOLDOWN=1800

# ==== آستانه‌های RSI ====
LONG_RSI_15M=35
LONG_RSI_1H=40
LONG_RSI_4H=45
SHORT_RSI_15M=65
SHORT_RSI_1H=60
SHORT_RSI_4H=55

# ==== Money Flow ====
FLOW_INTERVAL=300
FLOW_PERIOD=15m
MIN_FLOW_RATIO_SIGNAL=0.15
BINANCE_FLOW_MIN_RATIO=0.06
EARLY_FLOW_RATIO=0.08
EARLY_VOLUME_RATIO=1.3

# ==== PRE-MOVE (سیگنال چهارم - قبل از حرکت) ====
PREMOVE_ENABLED=true
# حجم: رشد کرده ولی زیر آستانهٔ انفجار سیگنال نهایی
PREMOVE_VOLUME_MIN=1.2
# قیمت نباید بیشتر از این حرکت کرده باشد (٪)
PREMOVE_MAX_PRICE_MOVE=0.8
# حداقل رشد OI (٪) به‌عنوان ورود پول
PREMOVE_OI_MIN=0.5
# حداقل یک‌طرفه بودن جریان پول
PREMOVE_FLOW_RATIO=0.05
# چند کندل قبل برای جهت RSI
PREMOVE_RSI_LOOKBACK=3
# حداقل امتیاز لازم از ۴ نشانه
PREMOVE_MIN_SCORE=3

# ==== GOLDEN ROTATION (سیگنال پنجم - چرخش پول از BTC به آلت) ====
ROTATION_ENABLED=true
# حداقل برتری تغییر ۲۴ ساعتهٔ آلت نسبت به BTC (٪)
ROTATION_REL_MIN=0.5

# ==== Open Interest ====
OI_PERIOD=15m
OI_LOOKBACK=5
REQUIRE_OI_RISING=false

# ==== Fear & Greed ====
FEAR_GREED_INTERVAL=3600
FEAR_GREED_MAX_LONG=0
FEAR_GREED_MIN_SHORT=0

# ==== CryptoMeter (اختیاری - پولی) ====
CRYPTOMETER_FLOW_INTERVAL=600
CRYPTOMETER_TIMEFRAME=15m

# ==== WEAKENING (سیگنال سوم - تضعیف حرکت) ====
WEAKENING_ENABLED=true
WEAKENING_RSI_DROP=10
WEAKENING_RSI_HIGH=60
WING_RSI_LOW=40
WEAKENING_RSI_LOOKBACK=3

# ==== لاگ ====
LOG_LEVEL=INFO
