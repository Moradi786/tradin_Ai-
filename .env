TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5

LIVECOINWATCH_API_KEY=YOUR_LIVECOINWATCH_API_KEY
CRYPTOMETER_API_KEY=YOUR_CRYPTOMETER_API_KEY

# اختیاری:
# اگر نگذاری، از CMC Public API استفاده می‌شود.
COINMARKETCAP_API_KEY=YOUR_COINMARKETCAP_API_KEY


SCAN_INTERVAL=120
MAX_SYMBOLS=100

VOLUME_MULTIPLIER=2.0
MAX_PRICE_MOVE=1.5
VOLUME_LOOKBACK=20


LONG_RSI_15M=35
LONG_RSI_1H=40
LONG_RSI_4H=45

SHORT_RSI_15M=65
SHORT_RSI_1H=60
SHORT_RSI_4H=55


SIGNAL_COOLDOWN=1800


# CryptoMeter
# هر 10 دقیقه یک بار Flow می‌گیرد
# تا مصرف API پایین بماند.
CRYPTOMETER_FLOW_INTERVAL=600
CRYPTOMETER_TIMEFRAME=15m


# LiveCoinWatch
LWC_INTERVAL=120
LWC_LIMIT=100


# Dominance
# CMC هر 5 دقیقه refresh می‌شود.
CMC_INTERVAL=300


# Early detection
EARLY_FLOW_RATIO=0.10
EARLY_VOLUME_RATIO=1.5


# Final signal
MIN_FLOW_RATIO_SIGNAL=0.15